# Application configuration
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to version control

# LLM Configuration (LLM_ prefix)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2
LLM_THINK=True
LLM_TIMEOUT=120
LLM_ENABLED=True

# OpenRouter Configuration (OPENROUTER_ prefix)
# Only required for the LLM-based DB populator
# (backend/src/scripts/populate_database_llm.py).
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=4096

# Database Configuration (DATABASE_ prefix)
# IMPORTANT: Set a strong password for production
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=helios
DATABASE_USER=heliosuser
DATABASE_PASSWORD=<generate-a-strong-password>

# Asset Configuration
INSCRIPTIONS_DIR=/app/assets/inscriptions
PERSEUS_DATA_DIR=/app/assets/canonical-greekLit/data

# Perseus MariaDB (perseus-db service, browsable via Adminer on :8080)
# Loaded from perseus/dumps/ on first boot of an empty volume.
PERSEUS_MYSQL_ROOT_PASSWORD=perseus
PERSEUS_MYSQL_DATABASE=perseus

# Authentication Configuration
# When DEBUG=False, Google OAuth is the only way to authenticate, and all three
# of SECRET_KEY, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are required — the
# app refuses to start without them rather than booting with no way to log in.
# IMPORTANT: Generate a real secret key with: openssl rand -hex 32
SECRET_KEY=<generate-with-openssl-rand-hex-32>
# Note: the JWT algorithm is pinned to HS256 in code and is not configurable.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

# Application Configuration (MiscSettings)
# DEBUG=True disables authentication entirely: every request resolves to a
# single shared dev@helios.local user, so all annotations are shared and open.
# It also mounts /docs and drops the SECRET_KEY requirement.
# IMPORTANT: Set DEBUG=False in production
APP_NAME=Helios API
DEBUG=False
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8888"]

# Frontend Configuration
VITE_API_URL=http://backend:8000
