# Application configuration
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to version control

# LLM Configuration (LLM_ prefix)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2
LLM_THINK=True
LLM_TIMEOUT=120
LLM_ENABLED=True

# OpenRouter Configuration (OPENROUTER_ prefix)
# Only required for the LLM-based DB populator
# (backend/src/scripts/populate_database_llm.py).
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=4096

# Database Configuration (DATABASE_ prefix)
# IMPORTANT: Set a strong password for production
# NOTE: DATABASE_* is canonical for the backend connection string (see
# backend/src/config.py DatabaseSettings). The postgres container itself reads
# POSTGRES_* (POSTGRES_USER/PASSWORD/DB), which this repo does not set — the
# stock image defaults apply and backend/src/scripts/init_db.sql creates the
# DATABASE_* role/database on first boot. Do not invent POSTGRES_* vars here
# expecting the backend to read them.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=helios
DATABASE_USER=heliosuser
DATABASE_PASSWORD=<generate-a-strong-password>
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_CONNECT_TIMEOUT=10

# Asset Configuration
INSCRIPTIONS_DIR=/app/assets/inscriptions
PERSEUS_DATA_DIR=/app/assets/canonical-greekLit/data

# Ithaca/Aeneas restore budget (seconds, enforced between beam-search
# generations; real ceiling is this plus one forward pass). Raise for
# pathological long restores; one restore holds the inference lock, so this
# also bounds how long concurrent restores wait (else 429).
ITHACA_TIME_BUDGET=180
# Ithaca/Aeneas inference cost/quality knobs (defaults preserve hardcoded behavior).
ITHACA_BEAM_WIDTH=35
ITHACA_MAX_BEAM_WIDTH=100
ITHACA_DEFAULT_MAX_RESTORATION_LEN=15
ITHACA_MAX_RESTORATION_LEN=20
ITHACA_TOP_CHARS=8
ITHACA_DEFAULT_TEMPERATURE=1.0
ITHACA_CONTEXT_TOP_K=20
ITHACA_ATTRIBUTION_LOCATIONS_KEPT=20
ITHACA_DATE_WINDOW_FRACTION=0.5
ITHACA_MODEL_GREEK_CKPT=ithaca_153143996_2.pkl
ITHACA_MODEL_LATIN_CKPT=aeneas_117149994_2.pkl
ITHACA_DATASET_GREEK=iphi.json
ITHACA_DATASET_LATIN=led.json

# Perseus MariaDB (perseus-db service, browsable via Adminer on :8080)
# Loaded from perseus/dumps/ on first boot of an empty volume.
PERSEUS_MYSQL_ROOT_PASSWORD=perseus
PERSEUS_MYSQL_DATABASE=perseus

# Docker / Compose infra tuning (all optional — defaults reproduce the
# previously hardcoded behavior; operators override these without editing files)
# Container images (pin or mirror as needed)
POSTGRES_IMAGE=pgvector/pgvector:pg16
OLLAMA_IMAGE=ollama/ollama:latest
PERSEUS_DB_IMAGE=mariadb:11
ADMINER_IMAGE=adminer:latest
# Service ports. *_HOST vars are the host-side published ports (freely tunable,
# e.g. to dodge collisions). Container-side BACKEND_PORT/FRONTEND_PORT need a
# rebuild; FRONTEND_PORT additionally requires editing frontend/Caddyfile's
# `:8888` site address (Caddyfile has no env templating).
BACKEND_PORT_HOST=8000
BACKEND_PORT=8000
FRONTEND_PORT_HOST=8888
FRONTEND_PORT=8888
OLLAMA_PORT_HOST=11434
# (ollama listens on 11434 inside the container; only the host side is tunable)
PERSEUS_PORT_HOST=3307
ADMINER_PORT_HOST=8080
# Backend resource caps (compose deploy.limits). BACKEND_CPUS_LIMIT is also
# forwarded as a build arg for the *_NUM_THREADS pools baked into
# backend/Dockerfile — rebuild the image to apply a changed limit there.
BACKEND_CPUS_LIMIT=5
BACKEND_MEMORY_LIMIT=10g
# Grace period for the backend healthcheck (covers XML rescan + JAX loads)
BACKEND_START_PERIOD=10m
# Trusted-proxy setting for uvicorn --forwarded-allow-ips (runtime, backend CMD)
FORWARDED_ALLOW_IPS=*
# Backend build args (used only via `docker build --build-arg` / compose build.args)
UBUNTU_VERSION=24.04
ITHACA_MODEL_BASE_URL=https://storage.googleapis.com/ithaca-resources/models
# UID (image user id, default 1100) is intentionally NOT listed here: most
# shells predefine a readonly UID that would silently override it via compose
# interpolation. Pass `--build-arg UID=...` explicitly if you need it.

# Authentication Configuration
# When DEBUG=False, Google OAuth is the only way to authenticate, and all three
# of SECRET_KEY, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are required — the
# app refuses to start without them rather than booting with no way to log in.
# IMPORTANT: Generate a real secret key with: openssl rand -hex 32
SECRET_KEY=<generate-with-openssl-rand-hex-32>
# Note: the JWT algorithm is pinned to HS256 in code and is not configurable.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google
SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
FRONTEND_FALLBACK_URL=http://localhost:3000

# Application Configuration (MiscSettings)
# DEBUG=True disables authentication entirely: every request resolves to a
# single shared dev@helios.local user, so all annotations are shared and open.
# It also mounts /docs and drops the SECRET_KEY requirement.
# IMPORTANT: Set DEBUG=False in production
APP_NAME=Helios API
DEBUG=False
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8888"]
HOST=0.0.0.0
PORT=8000
SESSION_MAX_AGE=3600
SLOW_REQUEST_THRESHOLD=0.5

# Pagination Configuration (PAGINATION_ prefix)
PAGINATION_DEFAULT_TEXTS_LIMIT=50
PAGINATION_MAX_TEXTS_LIMIT=100
PAGINATION_DEFAULT_SEGMENTS_LIMIT=1000
PAGINATION_MAX_SEGMENTS_LIMIT=5000
PAGINATION_DEFAULT_INSCRIPTIONS_LIMIT=50
PAGINATION_MAX_INSCRIPTIONS_LIMIT=200
PAGINATION_DEFAULT_ANNOTATIONS_LIMIT=100
PAGINATION_MAX_ANNOTATIONS_LIMIT=500
PAGINATION_MOST_ANNOTATED_TOP_N=10
PAGINATION_LIST_PREVIEW_CHARS=150

# Translate-assist / lexicon / loader tunables (ASSIST_ prefix)
ASSIST_MAX_TEXT_CHARS=600
ASSIST_TRANSLATION_MAX_CHARS=300
ASSIST_LEXICON_BASE_URL=https://logeion.uchicago.edu
ASSIST_PERSEUS_COMMIT_BATCH=100
ASSIST_LLM_COMMIT_BATCH=50
ASSIST_HEADER_CHUNK_MAX=4000
ASSIST_BODY_CHUNK_MAX=6000
ASSIST_PHI_BATCH_SIZE=500

# Frontend Configuration
# VITE_API_URL is wired through as a compose build arg (default below = what
# compose passes; override for local `npm run dev`, which uses the Vite proxy).
# The remaining VITE_* vars are read by Vite at BUILD time from the builder
# environment (see frontend/src/services/api.ts, main.tsx, pages/*,
# components/inscription/*). Only VITE_API_URL is forwarded by
# docker-compose.yml — the rest take effect for local builds from shell env,
# and need a Dockerfile ARG + compose build.args entry to reach the image.
VITE_API_URL=http://backend:8000
VITE_API_PREFIX=/api
VITE_API_TIMEOUT_MS=30000
VITE_LOGIN_PATH=/login
VITE_AUTH_TOKEN_KEY=auth_token
# VITE_DEFAULT_LANG is reserved but currently unused by the UI.
# VITE_DEFAULT_LANG=
VITE_TEXTS_PAGE_SIZE=30
VITE_INSCRIPTIONS_PAGE_SIZE=20
VITE_ENABLE_TRANSLATE_ASSIST=false
VITE_TRANSLATE_MAX_CHARS=600
VITE_RESTORE_TEMP=1.0
VITE_MAX_RESTORATION_LEN=15
VITE_CONTEXT_TOP_K=20
VITE_MODEL_STATUS_TTL_MS=60000
VITE_STATS_TTL_MS=300000
VITE_BROWSER_LIST_TTL_MS=60000
VITE_QUERY_RETRY=1
VITE_QUERY_STALE_MS=300000
VITE_MIN_TEXT_LEN=25
VITE_MAX_TEXT_LEN=760
VITE_TEMP_MIN=0.1
VITE_TEMP_MAX=2.0
VITE_TEMP_STEP=0.1
VITE_GAP_MIN=1
VITE_GAP_MAX=20
