# Application configuration
# It's recommended to change these values for production
# Rename this file to .env and fill in the values

# Security
# To generate a new secret key, you can use: openssl rand -hex 32
SECRET_KEY="your-super-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth
# Get these from the Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://heliosapi.goapp.site/auth/google/callback"

# CORS
CORS_ORIGINS=["*"]

# POSTGRES
POSTGRES_DB=helios
POSTGRES_USER=heliosuser
POSTGRES_PASSWORD=changeme
POSTGRES_INITDB_ARGS="-E UTF8"

# BACKEND
DEBUG=True

DATABASE_URL=postgresql://heliosuser:changeme@postgres:5432/helios

PERSEUS_DATA_DIR=/app/data/canonical-greekLit/data

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

SECRET_KEY="your-secret-key-change-in-production"
CORS_ORIGINS='["*"]'

GOOGLE_CLIENT_ID="9074946723760-19o3he5i3301972rmie23fper847sk8t.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"

# FRONTEND
VITE_API_URL=http://backend:8000
