# Application configuration
# It's recommended to change these values for production
# Rename this file to .env and fill in the values

# LLM Configuration (LLM_ prefix)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2
LLM_THINK=True
LLM_TIMEOUT=120
LLM_ENABLED=True

# Database Configuration (DATABASE_ prefix)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=helios
DATABASE_USER=heliosuser
DATABASE_PASSWORD=changeme

# Asset Configuration
JAX_MODELS_DIR=./models
PERSEUS_DATA_DIR=/app/data/canonical-greekLit/data

# Authentication Configuration
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

# Application Configuration (MiscSettings)
APP_NAME=Helios API
DEBUG=True
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Configuration
VITE_API_URL=http://backend:8000
