# Frontend operator-tunables. Copy to .env to override. All values below are the defaults.
# No behavior change is expected when these are unset.

# Backend base URL (axios baseURL + OAuth redirect base, Vite proxy target)
VITE_API_URL=http://localhost:8000
# API path prefix (axios endpoint prefix, 401-handler exempt path, Vite proxy key)
VITE_API_PREFIX=/api
# Axios request timeout in ms. Must exceed the slowest backend budget
# (ITHACA_TIME_BUDGET=180s for restores, LLM_TIMEOUT=120s for translate).
VITE_API_TIMEOUT_MS=300000
# Frontend login route (401 redirect target)
VITE_LOGIN_PATH=/login
# localStorage key for the auth token
VITE_AUTH_TOKEN_KEY=auth_token

# Dev server port (vite.config.ts, read via process.env)
VITE_PORT=3000

# React Query defaults
VITE_QUERY_RETRY=1
VITE_QUERY_STALE_MS=300000

# Pagination
VITE_TEXTS_PAGE_SIZE=30
VITE_INSCRIPTIONS_PAGE_SIZE=20

# React Query cache TTLs (ms)
VITE_STATS_TTL_MS=300000
VITE_MODEL_STATUS_TTL_MS=60000
# Inscription browser list freshness (ms)
VITE_BROWSER_LIST_TTL_MS=60000

# Inscription workbench defaults
VITE_RESTORE_TEMP=1.0
VITE_MAX_RESTORATION_LEN=15
VITE_DEFAULT_LANG=greek
VITE_CONTEXT_TOP_K=20

# Inscription input validation + sliders
VITE_MIN_TEXT_LEN=25
VITE_MAX_TEXT_LEN=760
VITE_TEMP_MIN=0.1
VITE_TEMP_MAX=2.0
VITE_TEMP_STEP=0.1
VITE_GAP_MIN=1
VITE_GAP_MAX=20

# Text reader translation assist
VITE_TRANSLATE_MAX_CHARS=600
# Set to 'true' to start with AI translate mode active
VITE_ENABLE_TRANSLATE_ASSIST=false
